# === JEMIMA SERVICE — Variables d'environnement ===
# Ce fichier est propre à JEMIMA SERVICE. Ne jamais partager de valeurs
# avec GOD.ROGWEBSERVICE ou un autre projet.

NODE_ENV=development
PORT=4000

# --- Base de données (PostgreSQL dédiée à JEMIMA SERVICE) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=jemima_user
DB_PASSWORD=change_me_in_production
DB_NAME=jemima_service_db

# --- Authentification ---
JWT_SECRET=change_me_generate_a_long_random_secret
JWT_EXPIRES_IN=8h

# --- Compte Super Admin initial (utilisé uniquement par le script de seed) ---
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- IA (Gemini) — clé serveur uniquement, jamais exposée au frontend ---
GEMINI_API_KEY=

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
